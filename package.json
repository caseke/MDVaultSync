{
	"name": "mdvaultsync",
	"version": "0.3.6",
	"description": "Obsidian plugin that syncs one vault to a personal OneDrive App Folder over Microsoft Graph.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "node --test \"test/**/*.test.ts\"",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "caseke",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.4",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"obsidian": "1.13.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1"
	}
}
